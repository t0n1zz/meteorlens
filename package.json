    "@react-navigation/stack": "^7.7.1",
    "@solana/web3.js": "^1.95.0",
    "buffer": "^6.0.3",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.2",
    "expo-constants": "~17.0.3",
    "expo-splash-screen": "~0.29.2",
    "expo-status-bar": "~2.0.0",
    "react": "19.1.0",
