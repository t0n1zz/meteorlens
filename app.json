{
  "expo": {
    "name": "DLMM Position Dashboard",
    "slug": "dlmm-dashboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "dlmm-dashboard",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f0f14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dlmm.dashboard"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f14"
      },
      "package": "com.dlmm.dashboard"
    },
    "extra": {}
  }
}
